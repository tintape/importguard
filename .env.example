# Copy to .env for running on the host with `uv run ...`. Docker Compose sets its own values.
# Local demo credentials only. Never reuse them for anything reachable from a network.
IMPORTGUARD_DATABASE_URL=postgresql+psycopg://importguard:importguard@localhost:5432/importguard
IMPORTGUARD_UPLOAD_DIR=var/uploads

# Limits (defaults shown)
IMPORTGUARD_MAX_UPLOAD_BYTES=52428800
IMPORTGUARD_MAX_ROWS=200000
IMPORTGUARD_MAX_STORED_ERRORS=1000
IMPORTGUARD_MAX_ATTEMPTS=3

# Days on the dashboard are computed in this IANA time zone; stored times are UTC.
IMPORTGUARD_REPORT_TIMEZONE=UTC

# Host names the web app answers to (JSON list). Keep it to localhost unless you add authentication.
IMPORTGUARD_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Tests: a database the test suite may DROP and recreate.
IMPORTGUARD_TEST_DATABASE_URL=postgresql+psycopg://importguard:importguard@localhost:5432/importguard_test
